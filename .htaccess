# Prevent Directory Listing
Options -Indexes

# Protect Sensitive Files
<FilesMatch "\.(sqlite|db|log|ini|jsonl)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# UTF-8 Encoding
AddDefaultCharset UTF-8
